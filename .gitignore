# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
dist/

# Secrets -- never commit credential files (any tool); keep templates
.env
.env.*
!.env.example

# Agent tooling. A global git ignore often hides .claude/ and .codex/ so they never
# land in a service repo; this repo is the source of truth for them, so re-include
# the directory first, then its contents, then re-exclude local-only files.
!.claude/
!.claude/**
!.codex/
!.codex/**
.claude/settings.local.json
.codex/settings.local.json
.claude/worktrees/
